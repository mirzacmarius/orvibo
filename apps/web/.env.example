# Cloudflare R2 — object storage for Orvibo images and videos
# Dashboard: R2 → Manage R2 API Tokens → Create token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=orvibo-assets

# Public URL for the bucket (custom domain or r2.dev public access)
# Example: https://pub-xxxxxxxx.r2.dev  or  https://assets.yourdomain.com
NEXT_PUBLIC_ORVIBO_ASSETS_URL=

# Used by next.config.mjs rewrites when the app should proxy asset paths to R2
ORVIBO_ASSETS_ORIGIN=
