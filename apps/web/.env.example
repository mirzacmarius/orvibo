# Cloudflare R2 — object storage for Orvibo images and videos (~1.3 GiB local)
#
# Setup:
#   1. wrangler login
#   2. wrangler r2 bucket create orvibo-assets
#   3. R2 bucket → Settings → Public access → Allow Access / custom domain
#   4. R2 → Manage R2 API Tokens → Object Read & Write
#   5. cp .env.example .env.local  (fill values below)
#   6. bun run orvibo:r2-preflight && bun run orvibo:upload-r2
#   7. bun run orvibo:verify-r2
#   8. Set the same NEXT_PUBLIC_* and ORVIBO_* on Vercel → redeploy
#
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=orvibo-assets

# Public URL for the bucket (r2.dev or custom domain, no trailing slash)
# Example: https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_ORVIBO_ASSETS_URL=

# Same origin as above — Next.js rewrites proxy /guanwang_second, /orvibo, /open, VOD paths
ORVIBO_ASSETS_ORIGIN=
